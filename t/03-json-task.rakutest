use Test;
use lib 'lib';
use LLM::Data::Inference::JSONTask;
use LLM::Chat::Backend;
use LLM::Chat::Backend::Settings;
use LLM::Chat::Backend::Response;
use LLM::Chat::Conversation::Message;
use UUID::V4;

# --- MockBackend (same as task test) ---

class MockBackend is LLM::Chat::Backend {
	has @.responses;
	has Int $!call-count = 0;

	method chat-completion(
		@messages where all(@messages) ~~ LLM::Chat::Conversation::Message,
		--> LLM::Chat::Backend::Response
	) {
		my Str:D $text = @!responses[$!call-count++ % @!responses.elems];
		my LLM::Chat::Backend::Response $r .= new(:id(uuid-v4()));
		start { $r.emit($text); $r.done; }
		$r;
	}

	method chat-completion-stream(@messages, --> LLM::Chat::Backend::Response) { self.chat-completion(@messages) }
	method text-completion(@messages, Bool $c = False, --> LLM::Chat::Backend::Response) { self.chat-completion(@messages) }
	method text-completion-stream(@messages, Bool $c = False, --> LLM::Chat::Backend::Response) { self.chat-completion(@messages) }
	method cancel(LLM::Chat::Backend::Response $r) { $r.cancel }
}

sub mock-backend(*@responses --> MockBackend:D) {
	MockBackend.new(:@responses, :settings(LLM::Chat::Backend::Settings.new));
}

plan 8;

subtest 'Valid JSON parsed correctly' => {
	plan 2;
	my MockBackend $b = mock-backend('{"name":"Alice","age":30}');
	my LLM::Data::Inference::JSONTask $task .= new(
		:backend($b), :user-prompt('Give me JSON'),
	);
	my $result = $task.execute;
	is $result<name>, 'Alice', 'Name parsed';
	is $result<age>, 30, 'Age parsed';
};

subtest 'JSON wrapped in prose extracted' => {
	plan 1;
	my MockBackend $b = mock-backend('Here is the JSON: {"key":"value"} Hope that helps!');
	my LLM::Data::Inference::JSONTask $task .= new(
		:backend($b), :user-prompt('Give me JSON'),
	);
	is $task.execute<key>, 'value', 'JSON extracted from prose';
};

subtest 'Required keys missing advances to next backend' => {
	plan 1;
	my MockBackend $b1 = mock-backend('{"name":"Alice"}');
	my MockBackend $b2 = mock-backend('{"name":"Bob","age":25}');
	my LLM::Data::Inference::JSONTask $task .= new(
		:backends($b1, $b2), :user-prompt('Need name and age'),
		:required-keys('name', 'age'),
	);
	my $result = $task.execute;
	is $result<age>, 25, 'Advanced until required keys present';
};

subtest 'Custom validator failure advances to next backend' => {
	plan 1;
	my MockBackend $b1 = mock-backend('{"score":5}');
	my MockBackend $b2 = mock-backend('{"score":15}');
	my LLM::Data::Inference::JSONTask $task .= new(
		:backends($b1, $b2), :user-prompt('High score'),
		:validator(-> %h { %h<score> > 10 }),
	);
	is $task.execute<score>, 15, 'Advanced until validator passed';
};

subtest 'Invalid JSON advances to next backend' => {
	plan 1;
	my MockBackend $b1 = mock-backend('not json at all');
	my MockBackend $b2 = mock-backend('{"valid":true}');
	my LLM::Data::Inference::JSONTask $task .= new(
		:backends($b1, $b2), :user-prompt('JSON please'),
	);
	ok $task.execute<valid>, 'Advanced past invalid JSON';
};

subtest 'Array JSON response' => {
	plan 2;
	my MockBackend $b = mock-backend('[1, 2, 3]');
	my LLM::Data::Inference::JSONTask $task .= new(
		:backend($b), :user-prompt('Array'),
	);
	my $result = $task.execute;
	isa-ok $result, Array, 'Array result';
	is $result.elems, 3, 'Three elements';
};

subtest 'Exhausted backend chain dies' => {
	plan 1;
	my MockBackend $b1 = mock-backend('garbage');
	my MockBackend $b2 = mock-backend('more garbage');
	my MockBackend $b3 = mock-backend('still garbage');
	my LLM::Data::Inference::JSONTask $task .= new(
		:backends($b1, $b2, $b3), :user-prompt('Never valid'),
	);
	dies-ok { $task.execute }, 'Dies after every backend returns unparseable text';
};

subtest 'Extraction hardening: reasoning chatter, fences, plan-out-loud' => {
	plan 6;

	sub run-one(Str:D $response) {
		my MockBackend $b = mock-backend($response);
		LLM::Data::Inference::JSONTask.new(
			:backend($b), :user-prompt('Give me JSON'),
		).execute;
	}

	is run-one(qq:to/END/)<events>[0]<kind>, 'mood_delta',
		Sure! Here's the JSON:
		```json
		\{"events": [\{"kind": "mood_delta"}]}
		```
		Let me know if you need anything else.
		END
		'code-fenced JSON extracted';

	is run-one(q:to/END/)<answer>, 42,
		<think>
		The user wants JSON. I should structure it as { key: value }
		— wait, arrays [ maybe? No, an object.
		</think>
		{"answer": 42}
		END
		'think-block with stray braces stripped before extraction';

	is run-one(q:to/END/)<events>[0], 'real',
		Let me sketch the shape first: {"draft": true} — okay, now
		the full answer with everything filled in properly:
		{"events": ["real"], "detail": "the actual full response body"}
		END
		'plan-out-loud: the longer complete object wins over the draft';

	is run-one('{"text": "a } inside a string", "n": 1}')<n>, 1,
		'braces inside JSON strings do not confuse the balanced scan';

	is run-one("prose [1, 2, 3] more prose")[2], 3,
		'top-level arrays still extract from prose';

	# Truncated output (no complete structure anywhere) falls back to
	# the legacy slice, which from-json rejects → chain exhausts with
	# the established parser error.
	throws-like {
		run-one('{"events": [{"kind": "mood_delta"')
	}, Exception, message => /'backend(s) exhausted'/,
		'truncated JSON still exhausts with a parser error';
};
