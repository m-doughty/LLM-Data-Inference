use Test;
use lib 'lib';
use LLM::Data::Inference::Task;
use LLM::Data::Inference::Exceptions;
use LLM::Chat::Backend::Mock;
use LLM::Chat::Backend::Settings;

# An exception class with no `message` method and no $.message attribute
# has no message: Exception.message is a `...` stub, so `.message` is a
# Failure of X::StubCode that throws the moment it is used as text. The
# Task reports exceptions from hooks, from the backend and from a
# parser; formatting any of those with `.message` threw a SECOND
# exception from inside the CATCH handler, which in a worker thread
# kills the process. A real case is Cro's PipelineClosedBeforeHeaders.
# Every site now reads the text through LLM::Chat::ExceptionText, which
# never throws and falls back to the class name.

plan 8;

my class X::NoMsg is Exception { }

# Stands in for $*ERR so a hook's `note` is asserted on instead of
# leaking onto the test run's stderr (zef shows it during install).
class ErrCapture {
	has Str $.text = '';
	method print(*@args) { $!text ~= @args.join; True }
	method say(*@args)   { $!text ~= @args.join ~ "\n"; True }
	method put(*@args)   { $!text ~= @args.join ~ "\n"; True }
	method print-nl      { $!text ~= "\n"; True }
	method flush         { True }
}

sub with-captured-err(&code --> Str:D) {
	my $capture = ErrCapture.new;
	{
		my $*ERR = $capture;
		code();
	}
	$capture.text;
}

sub mock-ok(Str $text) {
	LLM::Chat::Backend::Mock.new(
		settings  => LLM::Chat::Backend::Settings.new,
		responses => [$text],
	);
}

sub mock-failing(%error-hash) {
	LLM::Chat::Backend::Mock.new(
		settings       => LLM::Chat::Backend::Settings.new,
		responses      => ['(unreachable)'],
		error-producer => -> $call-idx { %error-hash },
	);
}

# A backend whose call itself raises, the way a transport library does
# when a connection drops mid-request.
class RaisingBackend is LLM::Chat::Backend::Mock {
	has $.to-raise;
	method chat-completion(|) { die $!to-raise }
}

subtest 'the fixture really has no message (guards the premise)' => {
	plan 2;
	my $stub = X::NoMsg.new.message;
	isa-ok $stub, Failure, '.message on a messageless class is a Failure';
	# Bound before the `try`, not made inside it: under `try` a Failure a
	# call returns is thrown without being marked handled, and at the next
	# garbage collection its DESTROY warns on stderr, which can land in a
	# later subtest's captured $*ERR.
	my Bool $threw = False;
	try { my $text = "$stub"; CATCH { default { $threw = True } } }
	$stub.so;  # handled whatever happened above, so it is never reported
	ok $threw, '... that throws as soon as it is used as text';
};

subtest 'an on-exhausted hook raising a messageless exception is shielded' => {
	plan 5;
	my $task = LLM::Data::Inference::Task.new(
		backend      => mock-failing({ class => 'timeout', message => 'timed out' }),
		user-prompt  => 'q',
		on-exhausted => -> %info { die X::NoMsg.new },
	);
	my $caught;
	my $died = False;
	my $noted = with-captured-err({
		$task.execute;
		CATCH {
			when X::LLM::Data::Inference::Exhausted { $caught = $_ }
			default { $died = True }
		}
	});
	ok $caught.defined, 'Exhausted is still thrown';
	nok $died, 'nothing else leaked out of execute';
	like $caught.message, /'exhausted'/, 'the Exhausted summary is intact';
	is $noted, "exhausted hook: X::NoMsg\n",
		'the note names the exception class';
	unlike $noted, /Stub/, '... and is not the stub error';
};

subtest 'a telemetry hook raising a messageless exception is shielded' => {
	plan 4;
	my @seen;
	my $task = LLM::Data::Inference::Task.new(
		backend          => mock-ok('all good'),
		user-prompt      => 'q',
		on-call-complete => -> %payload { @seen.push: %payload; die X::NoMsg.new },
	);
	my $result;
	my $died = False;
	my $noted = with-captured-err({
		$result = $task.execute;
		CATCH { default { $died = True } }
	});
	nok $died, 'execute does not die';
	is $result, 'all good', 'the result is unaffected by the broken sink';
	is @seen.elems, 1, 'the hook was reached exactly once';
	is $noted, "telemetry hook: X::NoMsg\n",
		'the note names the exception class';
};

subtest 'hook exceptions that DO have a message are reported verbatim' => {
	plan 2;
	my $task = LLM::Data::Inference::Task.new(
		backend          => mock-ok('all good'),
		user-prompt      => 'q',
		on-call-complete => -> %payload { die 'sink offline' },
	);
	my $noted = with-captured-err({ $task.execute });
	is $noted, "telemetry hook: sink offline\n", 'telemetry message kept';

	my $exhausting = LLM::Data::Inference::Task.new(
		backend      => mock-failing({ class => 'timeout', message => 'timed out' }),
		user-prompt  => 'q',
		on-exhausted => -> %info { die 'dlq offline' },
	);
	$noted = with-captured-err({
		$exhausting.execute;
		CATCH { when X::LLM::Data::Inference::Exhausted { } }
	});
	is $noted, "exhausted hook: dlq offline\n", 'exhausted message kept';
};

subtest 'a backend error carrying a messageless exception is recorded' => {
	plan 4;
	my $task = LLM::Data::Inference::Task.new(
		backend     => mock-failing({ class => 'unknown', message => X::NoMsg.new }),
		user-prompt => 'q',
		max-retries => 1,
	);
	my $caught;
	my $died = False;
	my $noted = with-captured-err({
		$task.execute;
		CATCH {
			when X::LLM::Data::Inference::Exhausted { $caught = $_ }
			default { $died = True }
		}
	});
	nok $died, 'the task does not die while reporting the error';
	ok $caught.defined, 'it exhausts normally, as for any other failure';
	like $caught.attempts[0]<error>, /'LLM call failed: X::NoMsg'/,
		'the recorded attempt names the exception class';
	is $noted, '', 'nothing was printed';
};

subtest 'a backend that raises a messageless exception is recorded' => {
	plan 5;
	my $backend = RaisingBackend.new(
		settings  => LLM::Chat::Backend::Settings.new,
		responses => ['(unreachable)'],
		to-raise  => X::NoMsg.new,
	);
	my $task = LLM::Data::Inference::Task.new(
		backend     => $backend,
		user-prompt => 'q',
		max-retries => 1,
	);
	my $caught;
	my $died = False;
	my $noted = with-captured-err({
		$task.execute;
		CATCH {
			when X::LLM::Data::Inference::Exhausted { $caught = $_ }
			default { $died = True }
		}
	});
	nok $died, 'the task does not die while reporting the error';
	ok $caught.defined, 'it exhausts normally';
	like $caught.attempts[0]<error>,
		/'LLM::Data::Inference::Task: X::NoMsg'/,
		'the recorded attempt names the exception class';
	unlike $caught.attempts[0]<error>, /Stub/, '... not the stub error';
	is $noted, '', 'nothing was printed';
};

subtest 'a parser that raises a messageless exception is recorded' => {
	plan 5;
	my $task = LLM::Data::Inference::Task.new(
		backend       => mock-ok('anything'),
		user-prompt   => 'q',
		parser        => sub (Str:D $text) { die X::NoMsg.new },
		parse-retries => 0,
	);
	my $caught;
	my $died = False;
	my $noted = with-captured-err({
		$task.execute;
		CATCH {
			when X::LLM::Data::Inference::Exhausted { $caught = $_ }
			default { $died = True }
		}
	});
	nok $died, 'the task does not die while reporting the parse error';
	ok $caught.defined, 'it exhausts normally';
	like $caught.attempts[0]<error>, /'parser: X::NoMsg'/,
		'the recorded attempt names the exception class';
	is $caught.attempts[0]<raw-text>, 'anything', 'the raw text is kept';
	is $noted, '', 'nothing was printed';
};

subtest 'a parser exception that DOES have a message keeps it' => {
	plan 2;
	my $task = LLM::Data::Inference::Task.new(
		backend       => mock-ok('anything'),
		user-prompt   => 'q',
		parser        => sub (Str:D $text) { die 'not json' },
		parse-retries => 0,
	);
	my $caught;
	{
		$task.execute;
		CATCH { when X::LLM::Data::Inference::Exhausted { $caught = $_ } }
	}
	ok $caught.defined, 'exhausts';
	like $caught.attempts[0]<error>, /'parser: not json'/,
		'the parser message is recorded verbatim';
};

done-testing;
